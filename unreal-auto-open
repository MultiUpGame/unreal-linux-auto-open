#!/usr/bin/env bash

UPROJECT="$1"
CONFIG="$HOME/.config/ue-versions.conf"

if [[ -z "$UPROJECT" || ! -f "$UPROJECT" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="File not found:\n$UPROJECT" 2>/dev/null
    exit 1
fi

ENGINE_VER=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get('EngineAssociation', ''))
except Exception:
    sys.exit(1)
" "$UPROJECT" 2>/dev/null)

if [[ -z "$ENGINE_VER" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Could not read engine version from:\n$UPROJECT" 2>/dev/null
    exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Config not found:\n$CONFIG\n\nRun install.sh first." 2>/dev/null
    exit 1
fi

EDITOR_PATH=$(grep -E "^\s*$(printf '%s' "$ENGINE_VER" | sed 's/[[\.*^$()+?{|]/\\&/g')\s*=" "$CONFIG" | head -1 | cut -d'=' -f2- | xargs)

# GUID not found — ask user to pick from known engines and save mapping
if [[ -z "$EDITOR_PATH" && "$ENGINE_VER" == "{"* ]]; then
    # Build list of known versions for zenity
    ZENITY_ARGS=()
    while IFS= read -r line; do
        [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
        [[ "$line" =~ ^\{ ]] && continue
        ver=$(echo "$line" | cut -d'=' -f1 | xargs)
        bin=$(echo "$line" | cut -d'=' -f2- | xargs)
        [[ -z "$ver" || -z "$bin" ]] && continue
        ZENITY_ARGS+=("$bin" "Unreal Engine $ver")
    done < "$CONFIG"

    if [[ ${#ZENITY_ARGS[@]} -eq 0 ]]; then
        zenity --error --title="Unreal Auto Open" \
            --text="No engines found in config.\n\nRun install.sh first." 2>/dev/null
        exit 1
    fi

    CHOSEN=$(zenity --list \
        --title="Unreal Auto Open" \
        --text="Project uses an unregistered engine ID:\n${ENGINE_VER}\n\nWhich engine should open it?" \
        --column="Path" --column="Version" \
        --hide-column=1 --print-column=1 \
        "${ZENITY_ARGS[@]}" 2>/dev/null)

    if [[ -z "$CHOSEN" ]]; then
        exit 0
    fi

    # Save GUID → engine mapping to config
    echo "" >> "$CONFIG"
    echo "# Auto-detected: ${ENGINE_VER}" >> "$CONFIG"
    echo "${ENGINE_VER} = ${CHOSEN}" >> "$CONFIG"

    EDITOR_PATH="$CHOSEN"
fi

if [[ -z "$EDITOR_PATH" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Version ${ENGINE_VER} not found in config.\n\nAdd this line to:\n$CONFIG\n\n${ENGINE_VER} = /path/to/UE4Editor" 2>/dev/null
    exit 1
fi

if [[ ! -f "$EDITOR_PATH" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Binary not found:\n$EDITOR_PATH\n\nCheck the path in:\n$CONFIG" 2>/dev/null
    exit 1
fi

"$EDITOR_PATH" "$UPROJECT" &
