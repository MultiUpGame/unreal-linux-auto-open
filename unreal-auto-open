#!/usr/bin/env bash

UPROJECT="$1"
CONFIG="$HOME/.config/ue-versions.conf"

if [[ -z "$UPROJECT" || ! -f "$UPROJECT" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="File not found:\n$UPROJECT" 2>/dev/null
    exit 1
fi

ENGINE_VER=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get('EngineAssociation', ''))
except Exception:
    sys.exit(1)
" "$UPROJECT" 2>/dev/null)

if [[ -z "$ENGINE_VER" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Could not read engine version from:\n$UPROJECT" 2>/dev/null
    exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Config not found:\n$CONFIG\n\nCreate the file and add your engine paths:\n4.27 = /path/to/UE4Editor" 2>/dev/null
    exit 1
fi

EDITOR_PATH=$(grep -E "^\s*${ENGINE_VER}\s*=" "$CONFIG" | head -1 | cut -d'=' -f2- | xargs)

if [[ -z "$EDITOR_PATH" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Version ${ENGINE_VER} not found in config.\n\nAdd this line to:\n$CONFIG\n\n${ENGINE_VER} = /path/to/UE4Editor" 2>/dev/null
    exit 1
fi

if [[ ! -f "$EDITOR_PATH" ]]; then
    zenity --error --title="Unreal Auto Open" \
        --text="Binary not found:\n$EDITOR_PATH\n\nCheck the path in:\n$CONFIG" 2>/dev/null
    exit 1
fi

"$EDITOR_PATH" "$UPROJECT" &
